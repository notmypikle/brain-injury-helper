<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <!-- Required by ContextCompat.registerReceiver(RECEIVER_NOT_EXPORTED)
         on Android 8–12 — without this the accessibility service crashes
         on bind on those versions (security review defect fix). -->
    <permission
        android:name="com.bih.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION"
        android:protectionLevel="signature" />
    <uses-permission android:name="com.bih.app.DYNAMIC_RECEIVER_NOT_EXPORTED_PERMISSION" />

    <!-- usesCleartextTraffic is allowed ONLY for local development (the API
         runs on your own device/network over http). Before any public
         release the API must be behind TLS and this removed (risk S2). -->
    <application
        android:label="@string/app_name"
        android:theme="@style/Theme.BIH"
        android:usesCleartextTraffic="true"
        android:exported="true">
        <activity
            android:name=".MainActivity"
            android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
            <!-- USER REQUEST (2026-11-10): "can I say hey B.I.H. like Gemini
                 or Bixby?" A true wake word needs phone-maker privileges,
                 but this lets B.I.H. become the DEFAULT ASSISTANT app — the
                 same hold-home-button / corner-swipe gesture Gemini uses
                 then opens B.I.H. from anywhere, even when closed. -->
            <intent-filter>
                <action android:name="android.intent.action.ASSIST" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>

        <!-- Quick Settings tile: swipe down from the top of any screen,
             tap B.I.H., app opens. -->
        <service
            android:name=".BihTileService"
            android:label="@string/app_name"
            android:icon="@android:drawable/ic_btn_speak_now"
            android:permission="android.permission.BIND_QUICK_SETTINGS_TILE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.quicksettings.action.QS_TILE" />
            </intent-filter>
        </service>

        <!-- Confirmation screen shown before any autofill happens. Not
             reachable from other apps. -->
        <activity
            android:name=".autofill.FillConfirmationActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.BIH" />

        <!-- Autofill service: the system binds to it (permission-guarded).
             Only ever reads the local profile cache; see BihAutofillService. -->
        <service
            android:name=".autofill.BihAutofillService"
            android:permission="android.permission.BIND_AUTOFILL_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.service.autofill.AutofillService" />
            </intent-filter>
            <meta-data
                android:name="android.autofill"
                android:resource="@xml/autofill_service" />
        </service>

        <!-- Screen-reading + filling service (user's cross-app idea).
             Only acts when the user taps the system accessibility button;
             see BihAccessibilityService for the safety rules. -->
        <activity
            android:name=".autofill.ScreenFillConfirmationActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.BIH" />

        <!-- The accessibility button's chooser + the big-text reader.
             Not reachable from other apps; never leave the recents list. -->
        <activity
            android:name=".autofill.AssistMenuActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.BIH" />
        <activity
            android:name=".autofill.ReadScreenActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:theme="@style/Theme.BIH" />

        <service
            android:name=".autofill.BihAccessibilityService"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE"
            android:exported="true">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data
                android:name="android.accessibilityservice"
                android:resource="@xml/accessibility_service_config" />
        </service>
    </application>
</manifest>
